# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# .claude — ignore scratch/planning docs; keep RE-DESIGN.md + docs/RLS.json (referenced by CLAUDE.md)
.claude/architecture-refactor/
.claude/design/design-plan.md
.claude/design/design-spec.md
.claude/settings.local.json

# stray local junk
cls

